{
  "expo": {
    "name": "TailorIQ",
    "slug": "tailoriq",
    "scheme": "tailoriq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tailoriq.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "TailorIQ uses the camera to capture front and side photos for measurement review.",
        "NSPhotoLibraryUsageDescription": "TailorIQ lets you choose measurement photos and style images from your photo library.",
        "NSUserNotificationsUsageDescription": "TailorIQ sends reminder alerts for fittings, pickups, and follow-ups you save.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tailoriq.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3b20c2e1-3521-43d5-bdd6-c0eb9daa6770"
      }
    }
  }
}
